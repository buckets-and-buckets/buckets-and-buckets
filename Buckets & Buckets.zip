    })();})();
</script>

<script>var IMG={"hero": "data:image/jpeg;base64,", "slider": "data:image/jpeg;base64,", "soup": "data:image/jpeg;base64,", "claw": "data:image/jpeg;base64,", "fry": "data:image/jpeg;base64,", "spread": "data:image/jpeg;base64,", "sides": "data:image/jpeg;base64,", "chef": "data:image/jpeg;base64,", "crab": "data:image/jpeg;base64,", "feast": "data:image/jpeg;base64,", "tray": "data:image/jpeg;base64,", "tap": "data:image/jpeg;base64,", "t_spread": "data:image/jpeg;base64,", "t_claw": "data:image/jpeg;base64,", "t_fry": "data:image/jpeg;base64,", "t_cup": "data:image/jpeg;base64,", "t_sides": "data:image/jpeg;base64,", "t_soup": "data:image/jpeg;base64,", "t_crab": "data:image/jpeg;base64,", "t_slider": "data:image/jpeg;base64,", "t_feast": "data:image/jpeg;base64,", "t_ice": "data:image/jpeg;base64,"};document.querySelectorAll('img[data-img]').forEach(function(i){i.src=IMG[i.getAttribute('data-img')];});</script>
</body>
</html>
