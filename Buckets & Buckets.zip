<script id="bb-offers">
/* BUCKETS & BUCKETS - OFFERS
   Add, edit or delete offers in the list below, then upload this file again.
   Nothing is shown on the website when the list is empty, or when every offer is switched off or outside its dates.

   For each offer:
     active  : true / false  - false hides it (handy for drafts)
     branch  : "all", "qurum" or "boulevard"
     start   : first day it shows, e.g. "2026-11-18"  (optional; time can be added: "2026-11-18 17:00")
     end     : last moment it shows, e.g. "2026-11-20 23:59" (optional; a date alone means the end of that day)
     color   : "yellow", "lilac", "peach" or "tomato"
     badge   : small sticker text, e.g. "Limited time"
     title   : headline         text : one or two lines of detail
     code    : optional word customers mention when ordering ("" for none)
     bar     : true shows the offer in the slim banner at the very top as well
     cta     : false hides the "Use this offer" button (for offers redeemed at the branch)
     value   : big number shown on the card, e.g. { en: "20%", ar: "20%" }, with unit: { en: "OFF", ar: "خصم" }
     points  : the offer as short bullet points, each { en, ar } (best for clarity)
     steps   : optional "How to redeem" list, each step { en, ar }
     value   : the big number on the card, e.g. { en: "15%", ar: "15%" }   unit : small word under it, e.g. { en: "OFF", ar: "خصم" }
     teaser  : a short curious line shown before the customer taps "Tap to reveal the offer"
     points  : the bullet points (add icon: "📍" to choose each symbol) on the card, each { en, ar } (keep each one short; put **double stars** around words to make them bold)
   Times use Oman time. English and Arabic are both supported. */
window.BB_OFFERS = [
  {
    id: "thawani-dine-in-15",
    active: true,
    branch: "all",
    color: "tomato",
    bar: false,
    cta: false,
    badge: { en: "Dine-in · Sun–Wed", ar: "داخل المطعم · الأحد–الأربعاء" },
    title: { en: "Thawani app offer", ar: "عرض تطبيق ثواني" },
    value: { en: "15%", ar: "15%" },
    unit: { en: "OFF", ar: "خصم" },
    teaser: { en: "Open your Thawani app before you dine with us. A treat is waiting for you.", ar: "افتح تطبيق ثواني قبل زيارتنا، ففي انتظارك عرض مميز." },
    points: [
      { icon: "🍽️", en: "**Dine-in** guests only", ar: "لتناول الطعام **داخل المطعم** فقط" },
      { icon: "🗓️", en: "Every **Sunday to Wednesday**", ar: "كل يوم من **الأحد إلى الأربعاء**" },
      { icon: "📍", en: "Valid at **Qurum** and **Boulevard**", ar: "ساري في **القرم** و**البوليفارد**" },
      { icon: "📱", en: "Redeem through the **Thawani app** at the branch", ar: "يُسترد عبر **تطبيق ثواني** في الفرع" }
    ],
    code: "",
    steps: [
      { en: "Show the offer: tell our staff you have a Thawani app offer, then show our offer page in the app.", ar: "أظهر العرض: أخبر الموظف أن لديك عرضاً من تطبيق ثواني، ثم اعرض صفحة عرضنا في التطبيق." },
      { en: "Original price: our staff will tell you the original bill amount.", ar: "السعر الأصلي: يخبرك الموظف بمبلغ الفاتورة الأصلي." },
      { en: "Discounted price: the final price after the discount appears in the app.", ar: "السعر بعد الخصم: يظهر السعر النهائي بعد الخصم في التطبيق." },
      { en: "Redemption code or QR: our staff will give you the redemption code, or a QR code to scan in the Thawani app.", ar: "رمز الاسترداد أو QR: يعطيك الموظف رمز الاسترداد أو رمز QR لمسحه عبر تطبيق ثواني." },
      { en: "Redeem: tap “Redeem Offer”.", ar: "الاسترداد: اضغط على «استرداد العرض»." },
      { en: "Confirmation: a “Verified” message confirms the offer has been redeemed.", ar: "التأكيد: تظهر رسالة «تم التحقق» لتأكيد نجاح الاسترداد." },
      { en: "Payment: pay the final discounted amount at the branch, in cash or by card.", ar: "الدفع: ادفع المبلغ النهائي بعد الخصم في الفرع، نقداً أو بالبطاقة." }
    ]
  },
  {
    id: "ladies-20-boulevard-oct",
    active: true,
    branch: "boulevard",
    start: "2026-10-18",
    end: "2026-10-21 23:59",
    color: "lilac",
    bar: false,
    cta: false,
    badge: { en: "18–21 Oct · Ladies", ar: "18–21 أكتوبر · للسيدات" },
    title: { en: "Omani’ Women's Day Offer", ar: "عرض يوم المرأة العُمانية" },
    value: { en: "20%", ar: "20%" },
    unit: { en: "OFF", ar: "خصم" },
    teaser: { en: "Calling all ladies! Gather your group, because a special treat is waiting for you.", ar: "إلى كل السيدات! اجمعن مجموعتكن، ففي انتظاركن مفاجأة مميزة." },
    points: [
      { icon: "👭", en: "Groups of **4 or more women** dining together", ar: "لمجموعات من **4 سيدات فأكثر** يتناولن الطعام معاً" },
      { icon: "🏷️", en: "**20% off** your total bill", ar: "**خصم 20%** على إجمالي الفاتورة" },
      { icon: "📅", en: "**18th to 21st October**", ar: "من **18 إلى 21 أكتوبر**" },
      { icon: "📍", en: "Al Araimi Boulevard Mall branch **only**", ar: "في فرع العريمي بوليفارد مول **فقط**" }
    ],
    code: ""
  }
];
</script>
<script>
(function () {
  var views = { home: document.getElementById("v-home"), qurum: document.getElementById("v-qurum"), boulevard: document.getElementById("v-boulevard") };
  var titles = {"home": "Best Seafood in Muscat | Seafood Buckets \u2013 Buckets & Buckets Oman", "qurum": "Seafood Restaurant in Qurum, Muscat \u2013 Buckets & Buckets Menu & Order", "boulevard": "Seafood Restaurant in Al Khoud, Muscat \u2013 Buckets & Buckets Boulevard"};
  function show() {
    var h = (location.hash || "").replace("#", "");
    if (!views[h]) h = "home";
    for (var k in views) views[k].hidden = (k !== h);
    document.title = titles[h];
    window.scrollTo(0, 0);
  }
  window.addEventListener("hashchange", function () {
    var h = (location.hash || "").replace("#", "");
    if (h.indexOf("menu-") === 0) return;
    show();
  });
  show();

  var root = document.documentElement;
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest("[data-scroll]");
    if (!a) return;
    e.preventDefault();
    var el = document.getElementById(a.getAttribute("data-scroll"));
    if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  (function () {
    var t = document.createElement("button"); t.type = "button"; t.className = "totop"; t.setAttribute("aria-label", "Back to top"); t.textContent = "↑";
    t.addEventListener("click", function () { window.scrollTo({ top: 0, behavior: "smooth" }); });
    document.body.appendChild(t);
    window.addEventListener("scroll", function () { t.classList.toggle("show", window.scrollY > 700); }, { passive: true });
  })();
  function showTab(btn) {
    var bar = btn.closest(".ptabs"), scope = bar.closest(".view") || document, id = btn.getAttribute("data-p");
    bar.querySelectorAll(".ptab").forEach(function (x) { var on = x === btn; x.classList.toggle("on", on); x.setAttribute("aria-selected", on ? "true" : "false"); });
    scope.querySelectorAll(".ppanel").forEach(function (p) { p.classList.toggle("on", p.getAttribute("data-pp") === id); });
    var r = bar.getBoundingClientRect(); if (r.top < 0 || r.top > 120) window.scrollTo({ top: Math.max(0, window.scrollY + r.top - 76), behavior: "smooth" });
    var rv = scope.querySelector(".ppanel.on"); if (rv) rv.querySelectorAll(".reveal").forEach(function (el) { el.classList.add("in", "vis", "show"); });
    if (id === "video") { var v = scope.querySelector("video"); if (v && v.paused) { var pp = v.play(); if (pp && pp.catch) pp.catch(function () {}); } }
  }
  document.addEventListener("click", function (e) {
    var t = e.target.closest && e.target.closest(".ptab");
    if (t) { e.preventDefault(); showTab(t); return; }
    var m = e.target.closest && e.target.closest("[data-ptab]");
    if (m) { var sc = m.closest(".view") || document, b = sc.querySelector('.ptab[data-p="' + m.getAttribute("data-ptab") + '"]'); if (b) showTab(b); }
  }, true);
  document.addEventListener("click", function (e) {
    var c = e.target.closest && e.target.closest("[data-copy]");
    if (!c) return;
    var t = c.getAttribute("data-copy"), done = function () { c.classList.add("ok"); setTimeout(function () { c.classList.remove("ok"); }, 1600); };
    try { navigator.clipboard.writeText(t).then(done, function () {}); } catch (x) {}
  });

  root.classList.add("js");
  function waSheet(url) {
    var sh = document.getElementById("wa-sheet"); if (!sh) return false;
    var m = /phone=(\d+)/.exec(url), d = m ? m[1] : "", num = d.length === 11 ? "+" + d.slice(0, 3) + " " + d.slice(3, 7) + " " + d.slice(7) : "+" + d;
    var br = d === "96899742274" ? "Boulevard · Al Araimi Boulevard Mall" : "Qurum · Qurum Garden Building";
    document.getElementById("wa-branch").textContent = "Buckets & Buckets " + br;
    document.getElementById("wa-open").href = url;
    var tx = (/[?&]text=([^&]*)/.exec(url) || [0, ""])[1];
    document.getElementById("wa-app").href = "whatsapp://send?phone=" + d + "&text=" + tx;
    document.getElementById("wa-web").href = "https://web.whatsapp.com/send?phone=" + d + "&text=" + tx;
    document.getElementById("wa-call").href = "tel:+" + d;
    var cp = document.getElementById("wa-copy"); cp.setAttribute("data-copy", num);
    var qr = document.getElementById("wa-qr"); qr.innerHTML = "";
    try { if (window.qrcode) { var q = window.qrcode(0, "M"); q.addData(url); q.make(); qr.innerHTML = q.createSvgTag({ cellSize: 6, margin: 2, scalable: true }); } } catch (x) {}
    qr.hidden = !qr.innerHTML;
    sh.hidden = false; document.body.classList.add("sheet-open");
    return true;
  }
  function closeSheet() { var sh = document.getElementById("wa-sheet"); if (sh) sh.hidden = true; document.body.classList.remove("sheet-open"); }
  document.addEventListener("click", function (e) {
    if (e.target.closest && e.target.closest("[data-close]")) { closeSheet(); return; }
    var a = e.target.closest && e.target.closest('a[href*="whatsapp.com/send"]');
    if (!a || a.id === "wa-open") return;
    e.preventDefault();
    var w = null;
    try { w = window.open(a.href, "_blank"); } catch (x) {}
    if (!w) waSheet(a.href); else { try { w.opener = null; } catch (x) {} }
  });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeSheet(); });
  document.querySelectorAll(".mtabs").forEach(function (bar) {
    var sec = bar.closest("section"); sec.classList.add("tabbed");
    function pick(id, scroll) {
      bar.querySelectorAll(".mtab").forEach(function (t) { var on = t.getAttribute("data-tab") === id; t.classList.toggle("on", on); t.setAttribute("aria-selected", on ? "true" : "false"); if (on && scroll) { try { bar.scrollTo({ left: t.offsetLeft - 16, behavior: "smooth" }); } catch (x) {} } });
      sec.querySelectorAll(".mpanel").forEach(function (p) { p.classList.toggle("act", p.id === id); });
    }
    bar.addEventListener("click", function (e) { var t = e.target.closest(".mtab"); if (t) { pick(t.getAttribute("data-tab"), true); var inp = sec.querySelector(".msearch input"); if (inp && inp.value) { inp.value = ""; inp.dispatchEvent(new Event("input")); } } });
    var grid = document.createElement("div"); grid.className = "mexplore";
    var gh = document.createElement("p"); gh.className = "mexp-h"; gh.innerHTML = '<span class="en">Tap a category to explore</span><span class="ar">اضغط على قسم لاستكشافه</span>'; grid.appendChild(gh);
    bar.querySelectorAll(".mtab").forEach(function (t) {
      var id = t.getAttribute("data-tab"), pn = document.getElementById(id), cnt = pn ? pn.querySelectorAll(".item .add, .item .pr").length : 0;
      var g = document.createElement("button"); g.type = "button"; g.className = "mx"; g.setAttribute("data-go", id);
      var im = t.querySelector("img"); if (im) { var i2 = document.createElement("img"); if (im.getAttribute("data-img")) i2.setAttribute("data-img", im.getAttribute("data-img")); else i2.src = im.getAttribute("src"); i2.alt = ""; i2.loading = "lazy"; g.appendChild(i2); } else { var te = t.querySelector(".te"); if (te) { var sp = document.createElement("span"); sp.className = "mxe"; sp.innerHTML = te.innerHTML; g.appendChild(sp); } }
      var lb = document.createElement("span"); lb.className = "mxl"; lb.innerHTML = t.querySelector(".tt").innerHTML; g.appendChild(lb);
      grid.appendChild(g);
    });
    var wrap0 = bar.closest(".mtabs-wrap") || bar; wrap0.parentNode.insertBefore(grid, wrap0.nextSibling);
    var all = document.createElement("button"); all.type = "button"; all.className = "mall"; all.innerHTML = '<span class="en">⌂ All</span><span class="ar">⌂ الكل</span>'; all.setAttribute("aria-label", "All categories");
    bar.insertBefore(all, bar.firstChild);
    function back() { bar.querySelectorAll(".mtab").forEach(function (t) { t.classList.remove("on"); t.setAttribute("aria-selected", "false"); }); sec.querySelectorAll(".mpanel").forEach(function (p) { p.classList.remove("act"); }); sec.classList.remove("picked"); }
    function open_(id) { pick(id, true); sec.classList.add("picked"); var pn2 = document.getElementById(id), t = (pn2 || bar).getBoundingClientRect(); window.scrollTo({ top: Math.max(0, window.scrollY + t.top - 215), behavior: "smooth" }); }
    grid.addEventListener("click", function (e) { var g = e.target.closest(".mx"); if (g) open_(g.getAttribute("data-go")); });
    sec.addEventListener("click", function (e) { if (e.target.closest(".mall")) { back(); var t = sec.getBoundingClientRect(); window.scrollTo({ top: Math.max(0, window.scrollY + t.top - 70), behavior: "smooth" }); } });
    bar.addEventListener("click", function (e) { if (e.target.closest(".mtab")) sec.classList.add("picked"); });
    back();
    var wrap = bar.closest(".mtabs-wrap") || bar.parentNode, pv = document.createElement("button"), nx = document.createElement("button");
    pv.type = nx.type = "button"; pv.className = "marr marr-l"; nx.className = "marr marr-r"; pv.textContent = "‹"; nx.textContent = "›";
    pv.setAttribute("aria-label", "Scroll categories left"); nx.setAttribute("aria-label", "Scroll categories right");
    wrap.appendChild(pv); wrap.appendChild(nx);
    function upd() { var max = bar.scrollWidth - bar.clientWidth, x = Math.abs(bar.scrollLeft), rtl = getComputedStyle(bar).direction === "rtl", left = rtl ? (max - x) > 4 : x > 4, right = rtl ? x > 4 : (max - x) > 4; pv.hidden = !left || max < 8; nx.hidden = !right || max < 8; }
    function go(d) { bar.scrollBy({ left: d * Math.max(180, bar.clientWidth * .7), behavior: "smooth" }); }
    pv.addEventListener("click", function () { go(-1); }); nx.addEventListener("click", function () { go(1); });
    bar.addEventListener("scroll", upd, { passive: true }); window.addEventListener("resize", upd); setTimeout(upd, 100); setTimeout(upd, 800);
  });
  var ms = document.querySelectorAll(".msearch input");
  function setPh() { var l = root.getAttribute("data-lang") === "ar" ? "ar" : "en"; for (var i = 0; i < ms.length; i++) ms[i].placeholder = ms[i].getAttribute("data-ph-" + l); }
  Array.prototype.forEach.call(ms, function (inp) {
    inp.addEventListener("input", function () {
      var v = inp.value.trim().toLowerCase(), sec = inp.closest("section"), any = false;
      sec.classList.toggle("searching", !!v);
      sec.querySelectorAll(".mpanel").forEach(function (dt) {
        var hit = 0;
        dt.querySelectorAll(".item").forEach(function (it) { var ok = !v || it.textContent.toLowerCase().indexOf(v) > -1 || (dt.querySelector("h3") || dt).textContent.toLowerCase().indexOf(v) > -1; it.style.display = ok ? "" : "none"; if (ok) hit++; });
        dt.style.display = hit ? "" : "none"; if (hit) any = true;
      });
      sec.querySelector(".nores").hidden = any || !v;
    });
  });
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } }); }, { threshold: .12, rootMargin: "0px 0px -6% 0px" });
    document.querySelectorAll(".stats > div, .bcard, .g, .sec-h, .reel > *, .strip .g").forEach(function (el, i) { el.classList.add("reveal"); el.style.transitionDelay = (i % 4) * 70 + "ms"; io.observe(el); });
  } else { root.classList.remove("js"); }
  var reel = document.getElementById("reel"), snd = document.getElementById("sound"), pb = document.getElementById("playbtn");
  if (reel) {
    var tryPlay = function () { var pp = reel.play(); if (pp && pp.catch) pp.catch(function () { if (pb) pb.hidden = false; }); };
    reel.addEventListener("playing", function () { if (pb) pb.hidden = true; });
    reel.addEventListener("pause", function () { if (pb && !reel.ended) pb.hidden = false; });
    
    if (pb) pb.addEventListener("click", function () { reel.muted = true; reel.load(); tryPlay(); });
    reel.addEventListener("click", function () { if (reel.paused) tryPlay(); });
    Array.prototype.forEach.call(reel.querySelectorAll("source"), function (so) { so.addEventListener("error", function () { if (pb && reel.paused) pb.hidden = false; }); });
    reel.muted = true; tryPlay();
    if ("IntersectionObserver" in window) new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.isIntersecting && reel.paused) tryPlay(); }); }, { threshold: .25 }).observe(reel);
    snd.addEventListener("click", function () {
      reel.muted = !reel.muted;
      snd.innerHTML = reel.muted ? '<span class="en">Sound off</span><span class="ar">بدون صوت</span>' : '<span class="en">Sound on</span><span class="ar">مع الصوت</span>';
      if (reel.paused) tryPlay();
    });
  }
  (function () {
    var PH = { qurum: "96871557044", boulevard: "96899742274" }, NM = { qurum: ["Qurum", "القرم"], boulevard: ["Boulevard", "البوليفارد"] };
    var cart = { qurum: {}, boulevard: {} };
    try { var sv = JSON.parse(localStorage.getItem("bb-cart") || "null"); if (sv && sv.qurum && sv.boulevard) cart = sv; } catch (e) {}
    function save() { try { localStorage.setItem("bb-cart", JSON.stringify(cart)); } catch (e) {} }
    function L() { return root.getAttribute("data-lang") === "ar" ? 1 : 0; }
    function fmt(b) { return "OMR " + (b / 1000).toFixed(3); }
    function cur() { var v = document.querySelector(".view:not([hidden])"), id = v && v.id; return id === "v-qurum" ? "qurum" : id === "v-boulevard" ? "boulevard" : null; }
    function sum(br) { var n = 0, t = 0, tx = 0, c = cart[br]; for (var k in c) { n += c[k].q; var ln = c[k].q * c[k].p; t += ln; if (!c[k].nv && !/^water/i.test(c[k].en)) tx += ln; } var v = Math.round(tx * 0.05); return { n: n, sub: t, vat: v, t: t + v }; }
    var bar = document.getElementById("cartbar"), sh = document.getElementById("cart-sheet");
    if (!bar || !sh) return;
    var toastT, pendingMenu = false;
    function hasBucket(br) { var c = cart[br]; for (var k in c) if (c[k].kind === "bkt") return true; return false; }
    function kindOf(b) { var k = b.getAttribute("data-kind"); if (k !== null) return k; var pn = b.closest(".mpanel"), h = pn && (pn.querySelector("h3 .en") || pn.querySelector("h3")), t = h ? h.textContent.toLowerCase() : ""; k = /upgrade/.test(t) ? "upg" : (/^buckets/.test(t) ? "bkt" : ""); b.setAttribute("data-kind", k); return k; }
    var HR = { qurum: function () { return [660, 1410]; }, boulevard: function (d) { return [660, (d === 4 || d === 5) ? 1440 : 1380]; } };
    function t12(m) { m = m % 1440; var h = Math.floor(m / 60), mm = m % 60, ap = h >= 12 ? "PM" : "AM", h2 = h % 12 || 12; return h2 + ":" + (mm < 10 ? "0" : "") + mm + " " + ap; }
    function slots(br) {
      var now = new Date(), d = now.getDay(), nm = now.getHours() * 60 + now.getMinutes(), hr = HR[br](d), out = [], start = Math.max(hr[0], Math.ceil((nm + 30) / 15) * 15), end = hr[1] - 30, i;
      for (i = start; i <= end; i += 15) out.push({ v: t12(i) + (L() ? " (اليوم)" : " (today)"), t: t12(i) + " today" });
      if (!out.length) { var hr2 = HR[br]((d + 1) % 7); for (i = hr2[0]; i <= hr2[1] - 30; i += 15) out.push({ v: t12(i) + (L() ? " (غدًا)" : " (tomorrow)"), t: t12(i) + " tomorrow" }); }
      return out;
    }
    function fillTime(br) { var sel = document.getElementById("cart-time"), old = sel.value; sel.innerHTML = ""; var ph = document.createElement("option"); ph.value = ""; ph.textContent = L() ? "اختر الوقت…" : "Select time…"; sel.appendChild(ph); slots(br).forEach(function (o) { var op = document.createElement("option"); op.value = o.t; op.textContent = o.v; sel.appendChild(op); }); if (old) sel.value = old; }
    function whenUi() { var ot = document.querySelector('input[name="otype"]:checked'), dine = ot && ot.value === "Dine in"; document.getElementById("when-en").textContent = dine ? "Arrival time" : "Pickup time"; document.getElementById("when-ar").textContent = dine ? "وقت الوصول" : "وقت الاستلام"; var tm = document.querySelector('input[name="wmode"]:checked'); document.getElementById("cart-time").hidden = !(tm && tm.value === "time"); document.getElementById("when-err").hidden = true; }
    document.addEventListener("change", function (e) { if (e.target.name === "otype" || e.target.name === "wmode") whenUi(); });
    try { if (sessionStorage.getItem("bb-menu")) { pendingMenu = true; sessionStorage.removeItem("bb-menu"); } } catch (e) {}
    function toast(m) { var t = document.getElementById("toast"); t.textContent = m; t.hidden = false; clearTimeout(toastT); toastT = setTimeout(function () { t.hidden = true; }, 1600); }
    function paint() {
      var br = cur(), s = br ? sum(br) : { n: 0, t: 0 }; if (br && pendingMenu) { pendingMenu = false; document.body.classList.add("menu-mode"); window.scrollTo(0, 0); } else if (!br && !pendingMenu) document.body.classList.remove("menu-mode");
      bar.hidden = !(br && s.n > 0); document.body.classList.toggle("has-cart", !bar.hidden);
      document.getElementById("cb-n").textContent = s.n; document.getElementById("cb-total").textContent = fmt(s.t);
      document.querySelectorAll(".mpanel").forEach(function (pn) {
        var h = pn.querySelector("h3 .en") || pn.querySelector("h3"); if (!h || !/upgrade/i.test(h.textContent)) return;
        var nt = pn.querySelector(".upg-note"); if (!nt) { nt = document.createElement("p"); nt.className = "upg-note"; nt.innerHTML = '<span class="en">Upgrades are available only when you order a bucket.</span><span class="ar">الإضافات متاحة فقط عند طلب دلو.</span>'; var items = pn.querySelector(".items"); pn.insertBefore(nt, items); }
        var brn = (pn.querySelector("[data-br]") || {}).getAttribute ? pn.querySelector("[data-br]").getAttribute("data-br") : null; nt.classList.toggle("ok", !!(brn && hasBucket(brn)));
      });
      document.querySelectorAll("[data-add]").forEach(function (b) {
        var q = (cart[b.getAttribute("data-br")][b.getAttribute("data-en")] || {}).q || 0;
        b.classList.toggle("in", q > 0); b.classList.toggle("locked", kindOf(b) === "upg" && !hasBucket(b.getAttribute("data-br")));
        var m = b.parentNode.querySelector(":scope > .minus");
        if (b.classList.contains("tp")) { var qb = b.querySelector(".qb"); if (q > 0) { if (!qb) { qb = document.createElement("em"); qb.className = "qb"; b.appendChild(qb); var mn = document.createElement("i"); mn.className = "mn"; mn.textContent = "−"; mn.setAttribute("aria-label", "Remove one"); b.appendChild(mn); } qb.textContent = q; } else if (qb) { qb.remove(); var mm = b.querySelector(".mn"); if (mm) mm.remove(); } }
        else if (q > 0 && !m) { m = document.createElement("button"); m.type = "button"; m.className = "minus"; m.setAttribute("data-minus", ""); m.setAttribute("data-br", b.getAttribute("data-br")); m.setAttribute("data-en", b.getAttribute("data-en")); m.setAttribute("aria-label", "Remove one"); m.textContent = "−"; b.parentNode.insertBefore(m, b); }
        else if (q === 0 && m) m.remove();
        if (!b.classList.contains("tp")) { var n = b.querySelector(".en"), a = b.querySelector(".ar"); if (n) n.textContent = q > 0 ? "Add · " + q : "Add"; if (a) a.textContent = q > 0 ? "أضف · " + q : "أضف"; }
      });
    }
    function change(br, en, d, ar, p, nv, kind) {
      var c = cart[br], it = c[en];
      if (!it) { if (d < 0) return; it = c[en] = { en: en, ar: ar || en, p: p, q: 0, nv: !!nv, kind: kind || "" }; }
      it.q += d; if (it.q <= 0) delete c[en];
      if (!hasBucket(br)) { var rm = false; Object.keys(c).forEach(function (k) { if (c[k].kind === "upg") { delete c[k]; rm = true; } }); if (rm) toast(L() ? "أُزيلت الإضافات: تتطلب طلب دلو" : "Upgrades removed: they need a bucket"); }
      save(); paint(); if (!sh.hidden) render();
    }
    function render() {
      var br = cur() || "qurum", c = cart[br], box = document.getElementById("cart-lines"), s = sum(br), l = L();
      document.getElementById("cart-branch").textContent = "Buckets & Buckets " + NM[br][l];
      box.innerHTML = "";
      Object.keys(c).forEach(function (k) {
        var it = c[k], row = document.createElement("div"); row.className = "cl";
