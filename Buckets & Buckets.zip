        if (d >= 1) return { en: "Ends in " + pl(d, "day", "days") + (h ? ", " + pl(h, "hour", "hours") : ""), ar: "ينتهي بعد " + arN(d, AD) + (h ? " و" + arN(h, AH) : "") };
        if (h >= 1) return { en: "Ends in " + pl(h, "hour", "hours") + (mm ? ", " + pl(mm, "minute", "minutes") : ""), ar: "ينتهي بعد " + arN(h, AH) + (mm ? " و" + arN(mm, AM) : "") };
        return { en: "Ends in " + pl(mm, "minute", "minutes"), ar: "ينتهي بعد " + arN(mm, AM) };
