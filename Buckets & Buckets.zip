        <select id="cart-time" hidden aria-label="Time"></select>
        <p class="when-err" id="when-err" hidden><span class="en">Please choose a time.</span><span class="ar">الرجاء اختيار وقت.</span></p>
      </div>
      <label><span class="en">Your name (optional)</span><span class="ar">اسمك (اختياري)</span><input id="cart-name" type="text" autocomplete="name" maxlength="60"></label>
      <label><span class="en">Notes: sauce, heat level, pickup time</span><span class="ar">ملاحظات: الصلصة، درجة الحرارة، وقت الاستلام</span><textarea id="cart-note" rows="2" maxlength="300"></textarea></label>
    </div>
    <div class="cart-sub" id="cart-subrow"><span><span class="en">Subtotal</span><span class="ar">المجموع الفرعي</span></span><b id="cart-sub">OMR 0.000</b></div>
    <div class="cart-sub" id="cart-vatrow"><span><span class="en">VAT 5% (water is VAT exempt)</span><span class="ar">ضريبة 5% (الماء معفى من الضريبة)</span></span><b id="cart-vatamt">OMR 0.000</b></div>
    <div class="cart-total" id="cart-totalrow"><span class="en">Total</span><span class="ar">الإجمالي</span><b id="cart-sum">OMR 0.000</b></div>
    <p class="cart-vat" id="cart-vat"><span class="en">Menu prices are before VAT. 5% VAT is added to every item except water, which is VAT exempt.</span><span class="ar">أسعار القائمة قبل الضريبة. تُضاف ضريبة 5% على كل الأصناف عدا الماء فهو معفى من الضريبة.</span></p>
    <a class="btn btn-wa" id="cart-send" href="#" target="_blank" rel="noopener noreferrer"><svg class="wai" aria-hidden="true"><use href="#i-wa"/></svg><span class="en">Send order on WhatsApp</span><span class="ar">أرسل الطلب عبر واتساب</span></a>
    <p class="cart-done" id="cart-done" hidden><span class="en">WhatsApp opened with your order. Press Send there and wait for our confirmation.</span><span class="ar">تم فتح واتساب بطلبك. اضغط إرسال هناك وانتظر تأكيدنا.</span></p>
    <button class="btn cart-more" type="button" data-cclose><span class="en">+ Add more items</span><span class="ar">+ أضف المزيد</span></button>
    <button class="cart-clear" type="button" id="cart-clear"><span class="en">Clear bucket</span><span class="ar">إفراغ السلة</span></button>
  </div>
</div>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

