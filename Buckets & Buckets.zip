    <p class="sheet-b" id="cart-branch"></p>
    <div class="cart-lines" id="cart-lines"></div>
    <p class="cart-empty" id="cart-empty"><span class="en">Your bucket is empty. Tap Add on any menu item.</span><span class="ar">سلتك فارغة. اضغط أضف على أي صنف.</span></p>
    <div class="cart-form" id="cart-form">
      <div class="otype" role="radiogroup"><label><input type="radio" name="otype" value="Takeaway" checked><span><span class="en">Takeaway</span><span class="ar">سفري</span></span></label><label><input type="radio" name="otype" value="Dine in"><span><span class="en">Dine in</span><span class="ar">في المطعم</span></span></label></div>
