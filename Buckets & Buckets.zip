        <article class="card bcard"><div class="bimg"><img data-img="claw" alt="Lobster and shrimp bucket at Buckets and Buckets Qurum" loading="lazy" decoding="async"></div><div class="bbody"><span class="tag"><span class="en">QURUM</span><span class="ar">القرم</span></span><h2><span class="en">Qurum branch</span><span class="ar">فرع القرم</span></h2><details class="hrs-d"><summary><span class="en">Opening hours</span><span class="ar">أوقات العمل</span></summary><div class="hrs"><span class="hr"><b><span class="en">Sun – Sat</span><span class="ar">الأحد – السبت</span></b><i><span class="en">11:00 AM – 11:30 PM</span><span class="ar">11:00 ص – 11:30 م</span></i></span></div></details><div class="actions"><a class="btn btn-wa" href="https://api.whatsapp.com/send?phone=96871557044&text=Hello%20Buckets%20%26%20Buckets%2C%20I%20would%20like%20to%20order" target="_blank" rel="noopener noreferrer"><svg class="wai" aria-hidden="true"><use href="#i-wa"/></svg>WhatsApp</a><a class="btn" href="https://maps.app.goo.gl/XwJsp2YpgRn4Bw6o9?g_st=ic" target="_blank" rel="noopener noreferrer"><span class="en">Directions</span><span class="ar">الاتجاهات</span></a><a class="btn btn-dark" data-gomenu href="#qurum"><span class="en">Menu</span><span class="ar">القائمة</span></a></div></div></article>
        <article class="card bcard"><div class="bimg"><img data-img="fry" alt="Shrimp tossed in sauce in a steel bowl at Buckets and Buckets Boulevard" loading="lazy" decoding="async"></div><div class="bbody"><span class="tag"><span class="en">AL KHOUD</span><span class="ar">الخوض</span></span><h2><span class="en">Boulevard branch</span><span class="ar">فرع البوليفارد</span></h2><details class="hrs-d"><summary><span class="en">Opening hours</span><span class="ar">أوقات العمل</span></summary><div class="hrs"><span class="hr"><b><span class="en">Sat – Wed</span><span class="ar">السبت – الأربعاء</span></b><i><span class="en">11:00 AM – 11:00 PM</span><span class="ar">11:00 ص – 11:00 م</span></i></span><span class="hr"><b><span class="en">Thu – Fri</span><span class="ar">الخميس – الجمعة</span></b><i><span class="en">11:00 AM – 12:00 AM</span><span class="ar">11:00 ص – 12:00 ص</span></i></span></div></details><div class="actions"><a class="btn btn-wa" href="https://api.whatsapp.com/send?phone=96899742274&text=Hello%20Buckets%20%26%20Buckets%2C%20I%20would%20like%20to%20order" target="_blank" rel="noopener noreferrer"><svg class="wai" aria-hidden="true"><use href="#i-wa"/></svg>WhatsApp</a><a class="btn" href="https://www.google.com/maps/search/?api=1&amp;query=Buckets%20%26%20Buckets%20Al%20Araimi%20Boulevard%20Mall%20Al%20Khoud%20Muscat" target="_blank" rel="noopener noreferrer"><span class="en">Directions</span><span class="ar">الاتجاهات</span></a><a class="btn btn-dark" data-gomenu href="#boulevard"><span class="en">Menu</span><span class="ar">القائمة</span></a></div></div></article>
