            sec.innerHTML = '<div class="of-h"><span class="of-dot"></span><b><span class="en">Offers</span><span class="ar">العروض</span></b></div><div class="of-empty"><h3><span class="en">No offers right now</span><span class="ar">لا توجد عروض حالياً</span></h3><p><span class="en">Our next promotion will appear here. Follow us on Instagram so you never miss one.</span><span class="ar">سيظهر عرضنا القادم هنا. تابعونا على إنستغرام حتى لا يفوتكم أي عرض.</span></p><div class="of-igs">' + igh + "</div></div>";
          } else
